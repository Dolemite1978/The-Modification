      ifOperation: (IS_GREATER_OR_EQUAL), Mem(ActReg7), Val(1)
        callSubroutine: s32'ABS_Special_06_Cancel'
      endIf: 
    endIf: 
    ifOperation: (IS_EQUAL), Mem(ActionTime), Val(42)
      ifOperation: (IS_EQUAL), Mem(ActReg7), Val(0)
        callSubroutine: s32'ABS_Special_06_Cancel'
      endIf: 
    endIf: 
    ifOperation: (IS_GREATER_OR_EQUAL), Mem(ActionTime), Val(54)
      ifOperation: (IS_EQUAL), Mem(ActReg7), Val(0)
        clearRegisteredUponCode: (IDLING)
        gotoLabelRequests: s32'end'
      endIf: 
    endIf: 
    ifOperation: (IS_GREATER_OR_EQUAL), Mem(ActionTime), Val(70)
      ifOperation: (IS_EQUAL), Mem(ActReg7), Val(1)
        clearRegisteredUponCode: (IDLING)
        gotoLabelRequests: s32'end'
      endIf: 
    endIf: 
    ifOperation: (IS_GREATER_OR_EQUAL), Mem(ActionTime), Val(70)
      ifOperation: (IS_EQUAL), Mem(ActReg7), Val(2)
        clearRegisteredUponCode: (IDLING)
        gotoLabelRequests: s32'end'
      endIf: 
    endIf: 
  endUpon: 
  ifOperation: (IS_EQUAL), Mem(ActReg7), Val(2)
    createObject: s32'abs_409Wind01_Lv3', (PLAYER)
  endIf: 
  gotoIfOperation: s32'loop_Lv1', (IS_EQUAL), Mem(ActReg7), Val(0)
  gotoIfOperation: s32'loop_Lv2', (IS_EQUAL), Mem(ActReg7), Val(1)
  gotoIfOperation: s32'loop_Lv3', (IS_EQUAL), Mem(ActReg7), Val(2)
  beginLabel: s32'loop_Lv1'
  sprite: s32'abs409_03', 5
  privateBankSfx: 2, s32'SE_BTL_ABS_21', 100
  sprite: s32'abs409_04', 5
  sprite: s32'abs409_05', 5
  sprite: s32'abs409_06', 5
