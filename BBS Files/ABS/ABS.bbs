beginState: s32'CmnActBDash'
  upon: (IMMEDIATE)
    callSubroutineWithArgs: s32'cmnBDash', Val(0), Val(0), Val(0), Val(0)
  endUpon: 
  sprite: s32'abs034_00', 4
  strikeInvulnerableForTime: 5
  landingAutoAction: 0
  upon: (TOUCH_GROUND)
    gotoLabelRequests: s32'landing'
  endUpon: 
  upon: (IDLING)
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(3)
      velocityXRate: 150
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(10)
      clearRegisteredUponCode: (IDLING)
      velocityXRate: 50
    endIf: 
  endUpon: 
  endLabel: 
  sprite: s32'abs034_01', 2
  sprite: s32'abs034_02', 2
  sprite: s32'abs034_03', 2
  sprite: s32'abs034_04', 3
  sprite: s32'abs034_05', 60
