    ifOperation: (IS_EQUAL), Mem(ActReg1), Val(2)
      storeValue: Mem(ActReg0), Val(170)
    endIf: 
  endIf: 
  else: 
    ifOperation: (IS_EQUAL), Mem(ActReg1), Val(0)
