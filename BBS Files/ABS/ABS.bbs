        endIf: 
      endIf: 
      ifOperation: (IS_GREATER_OR_EQUAL), Mem(ActionTime), Val(48)
        ifOperation: (IS_EQUAL), Mem(ActReg7), Val(0)
          clearRegisteredUponCode: (IDLING)
          gotoLabelRequests: s32'end'
        endIf: 
      endIf: 
      ifOperation: (IS_GREATER_OR_EQUAL), Mem(ActionTime), Val(48)
        ifOperation: (IS_EQUAL), Mem(ActReg7), Val(1)
          clearRegisteredUponCode: (IDLING)
          gotoLabelRequests: s32'end'
        endIf: 
      endIf: 
      ifOperation: (IS_GREATER_OR_EQUAL), Mem(ActionTime), Val(48)
        ifOperation: (IS_EQUAL), Mem(ActReg7), Val(2)
          clearRegisteredUponCode: (IDLING)
          gotoLabelRequests: s32'end'
        endIf: 
      endIf: 
    endUpon: 
    ifOperation: (IS_EQUAL), Mem(ActReg7), Val(0)
      statsActionName: s32'ABS_Special_06_Air_Lv1'
    endIf: 
    ifOperation: (IS_EQUAL), Mem(ActReg7), Val(1)
      statsActionName: s32'ABS_Special_06_Air_Lv2'
    endIf: 
    ifOperation: (IS_EQUAL), Mem(ActReg7), Val(2)
      statsActionName: s32'ABS_Special_06_Air_Lv3'
    endIf: 
  endUpon: 
