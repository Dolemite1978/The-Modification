beginSubroutine: s32'WFree_KobetsuFunc'
endSubroutine: 

beginSubroutine: s32'OnFrameStep'
  callSubroutine: s32'cmnOnFrameStep'
  isObjectActive: (STACK0)
  if: Mem(Tmp)
    ifOperationInObject: (IS_EQUAL), (STACK0), Mem(ActReg0), Val(1)
      if: Mem(BattleDoing)
        ifNot: Mem(IsSomebodysCutScene)
          ifNot: Mem(IsRoundTimerStop)
            calcDistanceEx: (DISTANCE_X), (STACK0), (PLAYER), (To3_MAIN_PLAYER), (PLAYER)
            ifOperation: (IS_LESSER_OR_EQUAL), Mem(Tmp), Val(280000)
              if: Mem(IsLand)
                ifNot: Mem(PlayerVal0)
                  modifyVar: (ADD), Mem(ExGauge0), Val(30)
                endIf: 
              endIf: 
              else: 
                checkCurrentStateName: (To3_MAIN_PLAYER), s32'CmnActBDash'
                if: Mem(Tmp)
                  ifNot: Mem(PlayerVal0)
                    modifyVar: (ADD), Mem(ExGauge0), Val(30)
                  endIf: 
                endIf: 
              endIf: 
            endIf: 
          endIf: 
        endIf: 
      endIf: 
    endIf: 
  endUpon: 
  if: Mem(PlayerVal0)
    tensionCooldown: 180
  endIf: 
  if: Mem(PlayerVal3)
    if: Mem(IsLand)
      checkCurrentStateName: (PLAYER), s32'ABS_Special_06_Land'
      ifNot: Mem(Tmp)
        checkCurrentStateName: (PLAYER), s32'ABS_Special_06_Air'
        ifNot: Mem(Tmp)
          storeValue: Mem(PlayerVal3), Val(0)
        endIf: 
      endIf: 
    endIf: 
  endIf: 
  if: Mem(ObjReg0)
  endIf: 
  else: 
    setCmnMaterialParam: 18, 2000, 0
  endElse: 
  if: Mem(PlayerVal0)
    ifNot: Mem(ObjReg1)
      ifOperation: (IS_GREATER_OR_EQUAL), Mem(ExGauge0), Val(0)
        setCmnMaterialParam: 20, 800, 0
      endIf: 
      ifOperation: (IS_GREATER), Mem(ExGauge0), Val(1200)
        setCmnMaterialParam: 20, 700, 0
      endIf: 
      ifOperation: (IS_GREATER), Mem(ExGauge0), Val(2400)
        setCmnMaterialParam: 20, 600, 0
      endIf: 
      ifOperation: (IS_GREATER), Mem(ExGauge0), Val(4800)
        setCmnMaterialParam: 20, 500, 0
      endIf: 
      ifOperation: (IS_GREATER), Mem(ExGauge0), Val(7200)
        setCmnMaterialParam: 20, 400, 0
      endIf: 
      ifOperation: (IS_GREATER), Mem(ExGauge0), Val(9600)
        setCmnMaterialParam: 20, 300, 0
      endIf: 
    endIf: 
    ifNot: Mem(IsRoundTimerStop)
      if: Mem(BattleDoing)
        ifNot: Mem(IsSomebodysCutScene)
          modifyVar: (ADD), Mem(ExGauge0), Val(-33)
        endIf: 
      endIf: 
    endIf: 
    walkFSpeed: 7200
    walkBSpeed: 5900
    initDashFSpeed: 20000
  endIf: 
  else: 
    walkFSpeed: 5200
    walkBSpeed: 4900
    initDashFSpeed: 15000
  endElse: 
endSubroutine: 

