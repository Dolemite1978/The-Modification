beginSubroutine: s32'CPUEstimate'
  callSubroutine: s32'cmn_TO3CPUEstimate'
  ifNot: Mem(PlayerVal0)
    ifOperation: (IS_LESSER), Mem(ExGauge0), Mem(ExGauge2)
      moveRewriteMode: 1
      addMove: s32'ABS_Special_01'
        cpuEstimatePoint: 120
      endMove: 
      moveRewriteMode: 1
      addMove: s32'ABS_Special_02_Land'
        cpuEstimatePoint: 50
      endMove: 
      moveRewriteMode: 1
      addMove: s32'ABS_Special_02_Air'
        cpuEstimatePoint: 50
      endMove: 
      moveRewriteMode: 1
      addMove: s32'ABS_Special_05'
        cpuEstimatePoint: 35
      endMove: 
      moveRewriteMode: 1
      addMove: s32'ABS_Special_06_Land'
        cpuEstimatePoint: 15
      endMove: 
      moveRewriteMode: 1
      addMove: s32'ABS_Special_06_Air'
        cpuEstimatePoint: 15
      endMove: 
    endIf: 
    ifOperation: (IS_LESSER), Mem(ExGauge0), Mem(ExGauge1)
      moveRewriteMode: 1
      addMove: s32'ABS_Special_01'
        cpuEstimatePoint: 150
      endMove: 
      moveRewriteMode: 1
      addMove: s32'ABS_Special_02_Land'
        cpuEstimatePoint: 25
        cpuEstimateAttackBox: -500, -284, 1380, 98
      endMove: 
      moveRewriteMode: 1
      addMove: s32'ABS_Special_02_Air'
        cpuEstimatePoint: 25
        cpuEstimateAttackBox: -500, -264, 646, 302
      endMove: 
      moveRewriteMode: 1
      addMove: s32'ABS_Special_05'
        cpuEstimatePoint: 0
      endMove: 
      moveRewriteMode: 1
      addMove: s32'ABS_Special_06_Land'
        cpuEstimatePoint: 0
      endMove: 
      moveRewriteMode: 1
      addMove: s32'ABS_Special_06_Air'
        cpuEstimatePoint: 0
      endMove: 
      moveRewriteMode: 1
      addMove: s32'ABS_ULT_02'
        cpuEstimatePoint: 0
      endMove: 
    endIf: 
  endIf: 
  else: 
    moveRewriteMode: 1
    addMove: s32'ABS_Special_01'
      cpuEstimatePoint: 0
    endMove: 
    moveRewriteMode: 1
    addMove: s32'ABS_Special_02_Land'
      cpuEstimatePoint: 120
      cpuEstimateInterval: 150
    endMove: 
    moveRewriteMode: 1
    addMove: s32'ABS_Special_02_Air'
      cpuEstimatePoint: 120
      cpuEstimateInterval: 150
    endMove: 
  endElse: 
  ifOperation: (IS_LESSER), Mem(ExGauge0), Val(6000)
    moveRewriteMode: 1
    addMove: s32'ABS_ULT_02'
      cpuEstimatePoint: 10
    endMove: 
  endIf: 
  ifOperation: (IS_LESSER), Mem(ExGauge0), Val(3600)
    moveRewriteMode: 1
    addMove: s32'ABS_ULT_02'
      cpuEstimatePoint: 0
    endMove: 
  endIf: 
  checkCurrentStateName: (SELF), s32'ABS_Special_06_Land'
  if: Mem(Tmp)
    moveRewriteMode: 1
    addMove: s32'NmlAtkAir5C'
      cpuEstimatePoint: 120
    endMove: 
    moveRewriteMode: 1
    addMove: s32'NmlAtkAir5E'
      cpuEstimatePoint: 120
    endMove: 
  endIf: 
  checkCurrentStateName: (SELF), s32'ABS_Special_06_Air'
  if: Mem(Tmp)
    moveRewriteMode: 1
    addMove: s32'NmlAtkAir5C'
      cpuEstimatePoint: 120
    endMove: 
    moveRewriteMode: 1
    addMove: s32'NmlAtkAir5E'
      cpuEstimatePoint: 120
    endMove: 
  endIf: 
  checkMoveFlag: (ENEMY_IN_HITSTUN)
  if: Mem(Tmp)
    skillHighEstimation: s32'ABS_Special_03'
    skillLowEstimation: s32'ABS_Special_04'
  endIf: 
  checkMoveFlag: (ENEMY_GUARD)
  if: Mem(Tmp)
    skillLowEstimation: s32'ABS_Special_04'
  endIf: 
endSubroutine: 

beginSubroutine: s32'CmnCutSceneDamage_Kakusei'
  ifOpponentCharacterMain: s16'pot'
  if: Mem(Tmp)
    debugLogForScript: s32'pot', 0, 0
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(2)
      debugLogForScript: s32'pot', 0, 425
      storeValue: Mem(ObjReg0), Val(1)
      setCmnMaterialParam: 18, 600, 0
    endIf: 
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(3)
      debugLogForScript: s32'pot', 0, 429
      setCmnMaterialParam: 18, 200, 0
    endIf: 
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(4)
      debugLogForScript: s32'pot', 0, 433
      setCmnMaterialParam: 18, 0, 0
    endIf: 
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(1)
      debugLogForScript: s32'pot', 0, 450
      storeValue: Mem(ObjReg0), Val(0)
      setCmnMaterialParam: 18, 1000, 0
    endIf: 
  endIf: 
  ifOpponentCharacterMain: s16'fau'
  if: Mem(Tmp)
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(16)
      storeValue: Mem(ActReg7), Val(0)
      findState: s32'cmn_AfroObj', 11, 2, 52
      isObjectActive: (STACK7)
      if: Mem(Tmp)
        runOnObject: (STACK7)
          setObjectWidth: 500
          setObjectHeight: 500
          setObjectDepth: 500
        endRunOnObject: 
      endIf: 
    endIf: 
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(20)
      storeValue: Mem(ActReg7), Val(0)
      findState: s32'cmn_AfroObj', 11, 2, 52
      isObjectActive: (STACK7)
      if: Mem(Tmp)
        runOnObject: (STACK7)
          setObjectWidth: 1000
          setObjectHeight: 1000
          setObjectDepth: 1000
        endRunOnObject: 
      endIf: 
    endIf: 
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(3)
      storeValue: Mem(ObjReg1), Val(1)
      setCmnMaterialParam: 20, 0, 0
    endIf: 
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(8)
      storeValue: Mem(ObjReg0), Val(1)
      setCmnMaterialParam: 18, 700, 0
    endIf: 
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(11)
      setCmnMaterialParam: 18, 200, 0
    endIf: 
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(5)
      setCmnMaterialParam: 18, 0, 0
    endIf: 
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(9)
      setCmnMaterialParam: 18, 200, 0
    endIf: 
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(10)
      setCmnMaterialParam: 18, 1000, 0
    endIf: 
    ifOperation: (IS_EQUAL), Mem(FuncArg0), Val(21)
      createObject: s32'ABS_fau500cs', (PLAYER)
      setCmnMaterialParam: 18, 3000, 0
      setCmnMaterialParam: 21, 2000, 0
    endIf: 
  endIf: 
  ifOpponentCharacterMain: s16'uni'
  if: Mem(Tmp)
    debugLogForScript: s32'uni', 0, 0
  endIf: 
endSubroutine: 

beginSubroutine: s32'ArcadeCheck'
  storeValue: Mem(ObjReg7), Val(0)
  findState: s32'ArcadeEvtABS_M', 8, 2, 60
  if: Mem(Tmp)
    storeValue: Mem(ObjReg7), Val(1)
  endIf: 
  findState: s32'ArcadeEvtABS_N', 8, 2, 60
