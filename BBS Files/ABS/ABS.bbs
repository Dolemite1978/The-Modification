beginState: s32'CmnActMatchWin'
  upon: (IMMEDIATE)
    callSubroutine: s32'cmnactmatchwin'
    cinesco: 1
    swapMeshSet: s32'800cs'
    if: Mem(PlayerVal0)
      storeValue: Mem(PlayerVal0), Val(0)
      ifOperation: (IS_GREATER_OR_EQUAL), Mem(ExGauge0), Val(0)
        setCmnMaterialParam: 20, 800, 0
      endIf: 
      ifOperation: (IS_GREATER), Mem(ExGauge0), Val(1200)
        setCmnMaterialParam: 20, 700, 0
      endIf: 
      ifOperation: (IS_GREATER), Mem(ExGauge0), Val(2400)
        setCmnMaterialParam: 20, 600, 0
      endIf: 
      ifOperation: (IS_GREATER), Mem(ExGauge0), Val(4800)
        setCmnMaterialParam: 20, 500, 0
      endIf: 
      ifOperation: (IS_GREATER), Mem(ExGauge0), Val(7200)
        setCmnMaterialParam: 20, 400, 0
      endIf: 
      ifOperation: (IS_GREATER), Mem(ExGauge0), Val(9600)
        setCmnMaterialParam: 20, 300, 0
      endIf: 
    endIf: 
  endUpon: 
  setCmnMaterialParam: 20, 0, 30
  sprite: s32'null', 2147483647
  upon: (IDLING)
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(1)
      displayMesh: s32'Head_High', 1
      displayMesh: s32'Head_Low', 0
      mouthPause: 0, 415
      ifNot: Mem(Afro)
        playAnimation: s32'abs800cs', 0
      endIf: 
      else: 
        playAnimation: s32'abs801cs', 0
      endElse: 
      checkLastStateName: s32'WinActionWait'
      if: Mem(Tmp)
        playCameraAnimation: s32'abs800cs', 23, 0, -1
      endIf: 
      else: 
        playCameraAnimation: s32'abs800cs', 23, 17, -1
      endElse: 
      cinesco: 1
      resetSaturation: 1, 1
      setPostProcessSaturation: -1, 800, 50
      resetDiffusion: 1, 1
      setDiffusionLuminance: -1, 1400, 50
      setDiffusionThreshold: -1, 0, 50
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(280)
      fadeOutStart: 0, 30
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(320)
      setSfxVolume: 0, 30
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(20)
      resetDOF: 1, 1
      focalDistance: -1, 700, 0
      focalRegion: -1, 0, 0
      focalNearTransition: -1, 0, 0
      focalFarTransition: -1, 500, 0
      focalNearBlurSize: -1, 0, 0
      focalFarBlurSize: -1, 40, 30
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(1)
      postProcessEffect: s32'PP_abs_filmnoise01', 1, 10
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(20)
      ifNot: Mem(Dir)
        createObject: s32'abs_winCS_scr_1p', (PLAYER)
      endIf: 
      else: 
        createObject: s32'abs_winCS_scr_2p', (PLAYER)
      endElse: 
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(184)
      ifTrueInObject: (To3_ENEMY_MAIN_PLAYER), Mem(CmnCharaReg22)
        runOnObject: (To3_ENEMY_MAIN_PLAYER)
          storeValue: Mem(CmnCharaReg22), Val(4)
        endRunOnObject: 
      endIf: 
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(240)
      fadeOutStart: 0, 120
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(300)
      createObject: s32'abs_winCS_vignette', (PLAYER)
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(424)
      sceneLightColor: 234, 151, 113
      sceneAmbientColor: 34, 28, 23
      ifNot: Mem(Dir)
        createObject: s32'abs_winCS_kanban_1p', (PLAYER)
      endIf: 
      else: 
        createObject: s32'abs_winCS_kanban_2p', (PLAYER)
      endElse: 
    endIf: 
    ifOperation: (IS_GREATER_OR_EQUAL), Mem(OnIdlingTime), Val(2)
      ifOperation: (IS_LESSER_OR_EQUAL), Mem(OnIdlingTime), Val(100)
        modifyVar: (ADD), Mem(ActReg0), Val(7500)
        setPushboxWidthFront: 2, 45
      endIf: 
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(270)
      hideAllButSelf: 1
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(0)
      cameraLightDirectionBlend: 0, 0
      cameraLightDirectionBlend: 1000, 17
      runOnObject: (To3_ENEMY_MAIN_PLAYER)
        cameraLightDirectionBlend: 0, 0
      endRunOnObject: 
      colorAreaBlend: 500, 17
      runOnObject: (To3_ENEMY_MAIN_PLAYER)
        colorAreaBlend: 500, 17
      endRunOnObject: 
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(1)
      characterSfx: s32'SE_BTL_ABS_MatchWin'
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(96)
      voiceLine: s16'vxxx601demo'
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(178)
      voiceLine: s16'vxxx602demo'
      jimaku: s32'prev', -2147483618
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(277)
      voiceLine: s16'vxxx603demo'
      jimaku: s32'prev', -2147483618
    endIf: 
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(435)
      voiceLine: s16'vxxx402demo'
      jimaku: s32'prev', -2147483618
      demoEndOnMouthEnd: 1
      demoEndYoinTime: 40
    endIf: 
  endUpon: 
endState: 

