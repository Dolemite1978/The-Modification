    ifOperation: (IS_GREATER_OR_EQUAL), Mem(ActionTime), Val(13)
      ifOperation: (IS_EQUAL), Mem(ActReg7), Val(0)
        callSubroutine: s32'ABS_Special_06_Move_Lv1'
      endIf: 
      else: 
        ifOperation: (IS_EQUAL), Mem(ActReg7), Val(1)
          callSubroutine: s32'ABS_Special_06_Move_Lv2'
        endIf: 
        else: 
          callSubroutine: s32'ABS_Special_06_Move_Lv3'
        endElse: 
      endElse: 
    endIf: 
