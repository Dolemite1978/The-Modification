beginState: s32'ABS_Special_06_Air'
  upon: (IMMEDIATE)
    attackIgnoreCaution: 1
    counterHitUkeru: 0
    recoveryState: 
    storeValue: Mem(PlayerVal3), Val(1)
    ifNot: Mem(PlayerVal0)
      ifOperation: (IS_LESSER), Mem(ExGauge0), Val(2520)
        storeValue: Mem(ActReg7), Val(0)
      endIf: 
      ifOperation: (IS_GREATER_OR_EQUAL), Mem(ExGauge0), Val(2520)
        storeValue: Mem(ActReg7), Val(1)
      endIf: 
      ifOperation: (IS_GREATER_OR_EQUAL), Mem(ExGauge0), Val(7320)
        storeValue: Mem(ActReg7), Val(2)
      endIf: 
    endIf: 
    else: 
      storeValue: Mem(ActReg7), Val(2)
    endElse: 
    skillFinishToDownLoop: 1
    displayMesh: s32'Bicycle', 1
    displayMesh: s32'toge', 1
    callSubroutine: s32'cmnLandingStiffadd_Timer'
    callSubroutine: s32'cmn_NoBlend'
    upon: (IDLING)
      ifOperation: (IS_EQUAL), Mem(ActionTime), Val(3)
        ifNot: Mem(PlayerVal0)
          modifyVar: (ADD), Mem(ExGauge0), Val(-2400)
        endIf: 
      endIf: 
      ifOperation: (IS_GREATER_OR_EQUAL), Mem(ActionTime), Val(9)
