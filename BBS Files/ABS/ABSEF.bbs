beginState: s32'to3_ABS_401_shot_obj'
  upon: (IMMEDIATE)
    specialAttack: 
    callSubroutineWithArgs: s32'cmn_TO3_RannyuAtk_Init', Val(3), Val(1), Val(0), Val(0)
    damage: Val(75)
    attackRange: 200000, -200000, -1, -1
    groundHitEffect: (AIR_FACE_UP)
    hitAirPushbackX: Val(18000)
    hitAirPushbackY: Val(35000)
    hitGravity: Val(3500)
    wallBlowoffType: (BLOWOFF_SLIDE)
    ignoreSlowdown: 1
    attackIgnoreCaution: 1
    upon: (REFLECTED)
      clearRegisteredUponCode: (REFLECTED)
      storeValue: Mem(ActReg6), Val(1)
      destroyOnPlayerEnemy: 0
    endUpon: 
    initializeDestroy: 
    numberOfHits: 1
    destroyOnClash: 1
    attackNoRecover: 0
    destroyOnPlayerEnemy: 1
    upon: (ON_DESTROY)
      clearRegisteredUponCode: (ON_DESTROY)
      clearRegisteredUponCode: (BEFORE_EXIT)
      clearRegisteredUponCode: (IDLING)
      clearRegisteredUponCode: (HIT_OR_GUARD_ANY_OBJECT)
      clearRegisteredUponCode: (TOUCH_GROUND)
      clearRegisteredUponCode: (NO_STOP_IDLING)
      clearRegisteredUponCode: (PROJECTILE_CLASH)
      linkParticle: s32''
      createObject: s32'ABS_401_delete', (PLAYER)
      gotoLabelRequests: s32'to3_koware'
    endUpon: 
    setMaxActionTime: 60
    upon: (HIT_OR_GUARD_ANY_OBJECT)
      requestDestroy: (SELF)
    endUpon: 
    upon: (BEFORE_EXIT)
      requestDestroy: (SELF)
    endUpon: 
    landingHeight: 0
    upon: (TOUCH_GROUND)
      requestDestroy: (SELF)
    endUpon: 
    upon: (NO_STOP_IDLING)
      if: Mem(CmnCharaReg3)
        requestDestroy: (SELF)
      endIf: 
      checkCurrentStateName: (To3_ENEMY_MAIN_PLAYER), s32'HomingJump'
      if: Mem(Tmp)
        requestDestroy: (SELF)
      endIf: 
      checkCurrentStateName: (PLAYER), s32'HomingJump'
      if: Mem(Tmp)
        requestDestroy: (SELF)
      endIf: 
    endUpon: 
  endUpon: 
  sprite: s32'_abs401_shot', 60
  createArgPointLightSide: 22
  linkParticleWithArg2: s32'abs_401_rocketpunch'
  physicsXImpulse: Val(22000)
  hit: 
  upon: (IDLING)
    ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(10)
      clearRegisteredUponCode: (IDLING)
      createObject: s32'ABS_401_Lv2_homing_start', (PLAYER)
      exPointFResetObject: (To3_ENEMY_MAIN_PLAYER), (CENTER), 0, 0
      createObject: s32'SearchObj', (EX_POINT_F)
      stackObject: (STACK0), (PREVIOUS)
      storeValueFromObject: (SELF), Mem(ActReg0), (STACK0), Mem(PosX)
      storeValue: Mem(ActReg1), Mem(PosX)
      modifyVar: (SUB), Mem(ActReg1), Mem(ActReg0)
      ifNot: Mem(Dir)
        modifyVar: (MUL), Mem(ActReg1), Val(-1)
      endIf: 
      storeValueFromObject: (SELF), Mem(ActReg2), (STACK0), Mem(PosY)
      storeValue: Mem(ActReg3), Mem(PosY)
      modifyVar: (SUB), Mem(ActReg3), Mem(ActReg2)
      modifyVar: (MUL), Mem(ActReg3), Val(-1)
      ifOperation: (IS_LESSER_OR_EQUAL), Mem(EnemyFrontDistance), Val(0)
        modifyVar: (MUL), Mem(ActReg1), Val(-1)
      endIf: 
      physicsXImpulse: Mem(ActReg1)
      physicsYImpulse: Mem(ActReg3)
      setAngleBySpeed: 0
      ifOperation: (IS_LESSER_OR_EQUAL), Mem(Angle), Val(180000)
        ifOperation: (IS_GREATER_OR_EQUAL), Mem(Angle), Val(30000)
          storeValue: Mem(Angle), Val(30000)
        endIf: 
      endIf: 
      else: 
        ifOperation: (IS_LESSER_OR_EQUAL), Mem(Angle), Val(330000)
          storeValue: Mem(Angle), Val(330000)
        endIf: 
      endElse: 
      ifOperation: (IS_EQUAL), Mem(SentToObject0), Val(0)
        if: Mem(IsEnemyDamage)
          ifOperationInObject: (IS_LESSER_OR_EQUAL), (PLAYER), Mem(EnemyDistanceY), Val(150000)
            storeValue: Mem(Angle), Val(0)
          endIf: 
        endIf: 
        ifOperationInObject: (IS_EQUAL), (To3_ENEMY_MAIN_PLAYER), Mem(PosY), Val(0)
          storeValue: Mem(Angle), Val(0)
        endIf: 
      endIf: 
      if: Mem(ActReg6)
        storeValue: Mem(Angle), Val(0)
      endIf: 
      setSpeedByAngle: 30000, 0
      velocityXPercent: 70
      velocityYPercent: 70
    endIf: 
  endUpon: 
  endLabel: 
  beginLabel: s32'to3_koware'
  sprite: s32'null', 60
  recoveryState: 
  haltMomentum: 1
endState: 

beginState: s32'DUMMY'
  sprite: s32'e0ea04_01', 2
endState: 

