beginState: s32'ABS_401_homing_obj'
  upon: (IMMEDIATE)
    specialAttack: 
    callSubroutineWithArgs: s32'cmn_AtkLv3', Val(5), Val(5), Val(0), Val(0)
    setProjectileDurability: 1
    damage: Val(16)
    attackReflect: 1
    damageEffect: (EX_POINT_4), s32'cmn_hit_sp_simple'
    attackRange: 200000, -200000, -1, -1
    ignoreSlowdown: 1
    attackIgnoreCaution: 1
    storeValue: Mem(CmnCharaReg11), Val(10000)
    storeValue: Mem(CmnCharaReg12), Val(0)
    storeValue: Mem(CmnCharaReg13), Val(5)
    callSubroutine: s32'cmn_hosei'
    if: Mem(SentToObject1)
      riscConsume: 0
      forcedComboScaleCount: 0
    endIf: 
    upon: (MAIN_PLAYER_RECEIVE_ATTACK)
      clearRegisteredUponCode: (MAIN_PLAYER_RECEIVE_ATTACK)
      clearRegisteredUponCode: (SIGNAL0)
      sendSignal: (PARENT), (SIGNAL0)
    endUpon: 
    upon: (SIGNAL0)
      clearRegisteredUponCode: (HIT)
      clearRegisteredUponCode: (SIGNAL0)
      riscConsume: 0
      forcedComboScaleCount: 0
    endUpon: 
    upon: (REFLECTED)
      clearRegisteredUponCode: (REFLECTED)
      destroyOnPlayerEnemy: 0
    endUpon: 
    upon: (SIGNAL1)
      clearRegisteredUponCode: (SIGNAL1)
      storeValue: Mem(ActReg6), Val(1)
      destroyOnPlayerEnemy: 0
    endUpon: 
    callSubroutineWithArgs: s32'cmn_SameAttack', Val(4), Val(0), Val(0), Val(0)
    groundHitEffect: (AIR_FACE_UP)
    hitAirPushbackX: Val(12000)
    hitAirPushbackY: Val(35000)
    hitGravity: Val(3500)
    wallBlowoffType: (BLOWOFF_SLIDE)
    callSubroutineWithArgs: s32'cmnWSB_Effect_NoStop_or_Delete', Val(0), Val(0), Val(0), Val(0)
    initializeDestroy: 
    numberOfHits: 1
    destroyOnEnemyDamage: 1
    destroyOnEnemyGuard: 1
    destroyOnClash: 1
    destroyOnPlayerEnemy: 1
    ifOperationInObject: (IS_EQUAL), (PARENT), Mem(ActReg1), Val(1)
      destroyOnPlayerEnemy: 0
    endIf: 
    upon: (ON_DESTROY)
      clearRegisteredUponCode: (ON_DESTROY)
      clearRegisteredUponCode: (BEFORE_EXIT)
      clearRegisteredUponCode: (TOUCH_GROUND)
      clearRegisteredUponCode: (IDLING)
      clearRegisteredUponCode: (NO_STOP_IDLING)
      clearRegisteredUponCode: (HIT_OR_GUARD_ANY_OBJECT)
      linkParticle: s32''
      createObject: s32'ABS_401_homing_delete', (PLAYER)
      gotoLabelRequests: s32'koware'
      cameraShakeEX: s32'Impact', 300, 0, 15, 0, s32'shake_easeout'
    endUpon: 
    ifTrueInObject: (PLAYER), Mem(PlayerDamage)
      callSubroutineWithArgs: s32'cmn_HajikareCheck', Val(0), Val(1), Val(0), Val(0)
      ifNot: Mem(ReturnValue)
        requestDestroy: (SELF)
      endIf: 
    endIf: 
    setMaxActionTime: 75
    upon: (BEFORE_EXIT)
      requestDestroy: (SELF)
    endUpon: 
    landingHeight: 0
    upon: (TOUCH_GROUND)
      requestDestroy: (SELF)
    endUpon: 
    upon: (HIT_OR_GUARD_ANY_OBJECT)
      requestDestroy: (SELF)
    endUpon: 
    upon: (NO_STOP_IDLING)
      if: Mem(CmnCharaReg3)
        requestDestroy: (SELF)
      endIf: 
      checkCurrentStateName: (To3_ENEMY_MAIN_PLAYER), s32'HomingJump'
      if: Mem(Tmp)
        requestDestroy: (SELF)
      endIf: 
      checkCurrentStateName: (PLAYER), s32'HomingJump'
      if: Mem(Tmp)
        requestDestroy: (SELF)
      endIf: 
    endUpon: 
    if: Mem(SentToObject0)
      ifOperation: (IS_EQUAL), Mem(SentToObject0), Val(1)
        setAngle: -15000
      endIf: 
      ifOperation: (IS_EQUAL), Mem(SentToObject0), Val(2)
        setAngle: 15000
      endIf: 
      ifOperation: (IS_EQUAL), Mem(SentToObject0), Val(3)
        setAngle: -40000
      endIf: 
      ifOperation: (IS_EQUAL), Mem(SentToObject0), Val(4)
        setAngle: 0
      endIf: 
      setSpeedByAngle: 20000, 0
    endIf: 
    upon: (IDLING)
      setAngleBySpeed: 0
      ifOperation: (IS_EQUAL), Mem(OnIdlingTime), Val(10)
        if: Mem(ActReg6)
          clearRegisteredUponCode: (IDLING)
          homingClear: 
        endIf: 
        ifOperation: (IS_LESSER_OR_EQUAL), Mem(EnemyFrontDistance), Val(-1)
          clearRegisteredUponCode: (IDLING)
          homingClear: 
        endIf: 
      endIf: 
      ifOperation: (IS_LESSER_OR_EQUAL), Mem(Angle), Val(180000)
        ifOperation: (IS_GREATER_OR_EQUAL), Mem(Angle), Val(31000)
          clearRegisteredUponCode: (IDLING)
          homingClear: 
          setAngle: 30000
        endIf: 
      endIf: 
      else: 
        ifOperation: (IS_LESSER), Mem(Angle), Val(310000)
          clearRegisteredUponCode: (IDLING)
          homingClear: 
          setAngle: 320000
        endIf: 
      endIf: 
    endUpon: 
    finishCameraRequest: s32'Cam_ABS_Special_01'
    statsActionName: s32'ABS_Special_02_Lv3_homing_obj'
  endUpon: 
  sprite: s32'_abs401_homing', 10
  createArgPointLightSide: 22
  ifNot: Mem(CmnCharaReg5)
    linkParticleWithArg2: s32'abs_401_rocketpunch_split'
  endIf: 
  else: 
    linkParticleWithArg2: s32'abs_401_rocketpunch_split_dust'
  endElse: 
  hit: 
  privateSE: s32'SE_BTL_ABS_12'
  privateSE: s32'SE_BTL_ABS_18_3'
  sprite: s32'_abs401_homing', 5
  homing: (ACCELERATE_TO_SPEED), (To3_ENEMY_MAIN_PLAYER), (CENTER), 0, 0, 0, 0, 0, 20000, 0, 5000
  ifOperationInObject: (IS_EQUAL), (PARENT), Mem(ActReg2), Val(1)
    ifOperationInObject: (IS_EQUAL), (To3_ENEMY_MAIN_PLAYER), Mem(PosY), Val(0)
      homing: (ACCELERATE_TO_SPEED), (To3_ENEMY_MAIN_PLAYER), (PLAYER), 0, 0, 0, 200000, 0, 20000, 0, 5000
    endIf: 
  endIf: 
  sprite: s32'_abs401_homing', 60
  homingClear: 
  setSpeedByAngle: 30000, 0
  velocityXPercent: 70
  velocityYPercent: 70
  endLabel: 
  beginLabel: s32'koware'
  sprite: s32'null', 1
  homingClear: 
  recoveryState: 
  haltMomentum: 1
endState: 

