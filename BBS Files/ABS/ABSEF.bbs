beginSubroutine: s32'ABS_UTL02_Bomb_AtkFunc'
  overdriveAttack: 
  callSubroutine: s32'cmn_AtkLv4'
  setProjectileDurability: 5
  damage: Val(45)
  tensionGainOnConnect: 0
  attackMultiHit: 1
  attackFrontDirection: (SELF_TO_ENEMY)
  hitSoftKnockdown: 0
  tensionGainOnConnect: 0
  attackReflect: 0
  shortHitstop: 1
  ignoreSlowdown: 1
  attackIgnoreCaution: 1
  storeValue: Mem(CmnCharaReg11), Val(1000000000)
  storeValue: Mem(CmnCharaReg12), Val(0)
  storeValue: Mem(CmnCharaReg13), Val(1)
  callSubroutineWithArgs: s32'cmn_hosei', Val(1), Val(0), Val(0), Val(0)
  callSubroutine: s32'cmnNohosei_kakusei'
  callSubroutine: s32'cmn_fuwafuwafuwa'
  groundHitEffect: (TAILSPIN)
  airHitEffect: (TAILSPIN)
  hitAirPushbackX: Val(40000)
  hitAirPushbackXOverTime: Val(90), Val(6), Val(12)
  hitAirPushbackY: Val(18000)
  hitAirPushbackYOverTime: Val(80), Val(6), Val(20)
  hitGravity: Val(1800)
  hitGravityOverTime: Val(150), Val(20), Val(30)
endSubroutine: 

beginState: s32'ABS_UTL02_Bomb_Enemy'
  upon: (IMMEDIATE)
    callSubroutine: s32'ABS_UTL02_Bomb_AtkFunc'
    hitEffectFire: 1
    upon: (FRAME_STEP)
      if: Mem(CmnCharaReg3)
        linkObjPosition: 2
        modifyVar: (ADD), Mem(ActReg0), Val(1)
        ifOperation: (IS_GREATER), Mem(ActReg0), Val(5)
          clearRegisteredUponCode: (FRAME_STEP)
          linkObjPosition: 0
        endIf: 
      endIf: 
    endUpon: 
    upon: (MAIN_PLAYER_RECEIVE_ATTACK)
      clearRegisteredUponCode: (MAIN_PLAYER_RECEIVE_ATTACK)
      ifNot: Mem(CmnCharaReg5)
        callSubroutine: s32'cmn_AtkTemplWSB'
        attackExHitParam: Val(0), 0, 0, 1, (DEFENDER), Mem(CmnCharaReg7)
        forceWallBreak: 1
        wallBreakLimitTime: 5
        disableWallBreak: 1
      endIf: 
      callSubroutine: s32'cmnWSB_Event_Status'
      ifOperation: (IS_EQUAL), Mem(ReturnValue), Val(1)
        upon: (NO_STOP_IDLING)
          ifNotInObject: (To3_ENEMY_MAIN_PLAYER), Mem(HitPoint)
            if: Mem(CmnCharaReg3)
              ignoreFinishStop: 1
              modifyVar: (ADD), Mem(ActReg1), Val(1)
              ifOperation: (IS_GREATER_OR_EQUAL), Mem(ActReg1), Val(10)
                clearRegisteredUponCode: (NO_STOP_IDLING)
                ignoreFinishStop: 0
                callSubroutineWithArgs: s32'cmnWSB_Event_Settings', Val(2), Val(0), Val(0), Val(0)
              endIf: 
            endIf: 
          endIf: 
        endUpon: 
      endIf: 
    endUpon: 
    missionName: s32'ABS_UTL02_Bomb'
  endUpon: 
  sprite: s32'null', 2
  sprite: s32'_ABS_UTL02_Bomb', 3
  hit: 
  linkParticle: s32'abs_502Explosion01'
  cameraShakeEX: s32'Impact', 1200, 0, 60, 0, s32'shake_easeout'
  sprite: s32'null', 57
  recoveryState: 
endState: 

beginState: s32'ABS_UTL02_Bomb_Friend'
